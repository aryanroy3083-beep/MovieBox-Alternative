# CineVerse AI — Environment Configuration
# Copy this file to .env to customize settings.
# Note: CineVerse AI runs 100% out of the box with zero config using local storage and built-in semantic AI simulation!

# ==============================================================================
# 1. SERVER-SIDE SECRETS (NEVER EXPOSE TO BROWSER CLIENT)
# WARNING: Never prefix sensitive keys with VITE_ as Vite will bundle them into public JS!
# ==============================================================================
PORT=5000
NODE_ENV=development

# Mandatory in production for signing JWT tokens and playback tickets:
# Generate with: openssl rand -base64 32
JWT_SECRET=cineverse_super_secure_production_secret_key_2026

# (Optional) Google Gemini API Key for Server-Side Live Generative Movie AI Assistant
# Keep this ONLY on the backend server:
# GEMINI_API_KEY=""

# (Optional) Allowed CORS Origins in Production (comma-separated):
# ALLOWED_ORIGINS="http://localhost:5173,https://cineverse.ai"

# ==============================================================================
# 2. CLIENT-SIDE PUBLIC CONFIGURATION (SAFE TO EXPOSE TO BROWSER)
# ==============================================================================
# VITE_APP_NAME="CineVerse AI"
# VITE_APP_ENV="development"

# (Optional) Supabase Public Anon Configuration for Cloud Sync & Auth
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-public-key"

